32.name= ~min_obstacle_dist
32.default= 0.5
32.type= double
32.desc=Minimum desired separation from obstacles Range: 0.0 to 10.0
33.name= ~inflation_dist
33.default= 0.6
33.type= double
33.desc=Buffer zone around obstacles with non-zero penalty costs (should be larger than min_obstacle_dist in order to take effect) Range: 0.0 to 15.0
34.name= ~dynamic_obstacle_inflation_dist
34.default= 0.6
34.type= double
34.desc=Buffer zone around predicted locations of dynamic obstacles with non-zero penalty costs (should be larger than min_obstacle_dist in order to take effect) Range: 0.0 to 15.0
35.name= ~include_dynamic_obstacles
35.default= False
35.type= bool
35.desc=Specify whether the movement of dynamic obstacles should be predicted by a constant velocity model (this also changes the homotopy class search). If false, all obstacles are considered to be static. 
36.name= ~include_costmap_obstacles
36.default= True
36.type= bool
36.desc=Specify whether the obstacles in the costmap should be taken into account directly (this is necessary if no seperate clustering and detection is implemented) 
37.name= ~legacy_obstacle_association
37.default= False
37.type= bool
37.desc=If true, the old association strategy is used (for each obstacle, find the nearest TEB pose), otherwise the new one (for each teb pose, find only 'relevant' obstacles). 
38.name= ~obstacle_association_force_inclusion_factor
38.default= 1.5
38.type= double
38.desc=The non-legacy obstacle association technique tries to connect only relevant obstacles with the discretized trajectory during optimization, all obstacles within a specifed distance are forced to be included (as a multiple of min_obstacle_dist), e.g. choose 2.0 in order to consider obstacles within a radius of 2.0*min_obstacle_dist. Range: 0.0 to 100.0
39.name= ~obstacle_association_cutoff_factor
39.default= 5.0
39.type= double
39.desc=See obstacle_association_force_inclusion_factor, but beyond a multiple of [value]*min_obstacle_dist all obstacles are ignored during optimization. obstacle_association_force_inclusion_factor is processed first. Range: 1.0 to 100.0
40.name= ~costmap_obstacles_behind_robot_dist
40.default= 1.5
40.type= double
40.desc=Limit the occupied local costmap obstacles taken into account for planning behind the robot (specify distance in meters) Range: 0.0 to 20.0
41.name= ~obstacle_poses_affected
41.default= 30
41.type= int
41.desc=The obstacle position is attached to the closest pose on the trajectory to reduce computational effort, but take a number of neighbors into account as well Range: 0 to 200
42.name= ~obstacle_proximity_ratio_max_vel
42.default= 1.0
42.type= double
42.desc=Ratio of the maximum velocities used as an upper bound when reducing the speed due to the proximity to static obstacles Range: 0.0 to 1.0
43.name= ~obstacle_proximity_lower_bound
43.default= 0.0
43.type= double
43.desc=Distance to a static obstacle for which the velocity should be lower Range: 0.0 to 10.0
44.name= ~obstacle_proximity_upper_bound
