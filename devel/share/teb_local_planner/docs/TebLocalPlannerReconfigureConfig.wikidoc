69.name= ~weight_gauss
69.default= 2.0
69.type= double
69.desc=Some special weights (currently 'weight_gauss') are repeatedly scaled by this factor in each outer TEB iteration (weight_new: weight_old * factor); Increasing weights iteratively instead of setting a huge value a-priori leads to better numerical conditions of the underlying optimization problem. Range: 0.0 to 100.0
70.name= ~obstacle_cost_exponent
70.default= 1.0
