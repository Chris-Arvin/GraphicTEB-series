89.name= ~roadmap_graph_area_length_scale
89.default= 1.0
89.type= double
89.desc=The length of the rectangular region is determined by the distance between start and goal. This parameter further scales the distance such that the geometric center remains equal!) Range: 0.5 to 2.0
90.name= ~h_signature_prescaler
90.default= 1.0
90.type= double
90.desc=Scale number of obstacle value in order to allow huge number of obstacles. Do not choose it extremly low, otherwise obstacles cannot be distinguished from each other (0.2<H<=1) Range: 0.2 to 1.0
91.name= ~h_signature_threshold
91.default= 0.1
91.type= double
91.desc=Two h-signuteres are assumed to be equal, if both the difference of real parts and complex parts are below the specified threshold Range: 0.0 to 1.0
92.name= ~obstacle_heading_threshold
92.default= 0.45
92.type= double
